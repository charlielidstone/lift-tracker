{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "supabase/functions",
    "src/components/ui/dotmatrix-core.tsx",
    "src/components/ui/dotmatrix-hooks.ts",
    "src/components/ui/dotm-*.tsx"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/sw.js"],
      "env": { "serviceworker": true, "browser": true, "es2024": true }
    }
  ]
}
