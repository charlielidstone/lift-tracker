# Supabase — copy to .env.local and fill with your project's values.
# Dashboard → Project Settings → API. The anon key is safe for the browser
# (public by design; row-level security is what protects data).
# Vite only exposes vars prefixed with VITE_ to the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Require login to use the app. Off by default (single-user dev). Set to 'true'
# to enforce auth once multi-user is ready.
VITE_REQUIRE_AUTH=false
